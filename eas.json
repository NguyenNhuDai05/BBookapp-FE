      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beautybook-13zj.onrender.com/api",
        "BBOOK_ADVISOR_ENABLED": "1",
        "BBOOK_ADVISOR_CLOUD_ENABLED": "0",
        "BBOOK_ADVISOR_DATA_PROCESSING_APPROVAL": "pending"
      }
    },
    "tester-aab": {
      "distribution": "store",
      "developmentClient": false,
      "credentialsSource": "remote",
      "autoIncrement": true,
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beautybook-13zj.onrender.com/api",
        "BBOOK_ADVISOR_ENABLED": "1",
        "BBOOK_ADVISOR_CLOUD_ENABLED": "0",
        "BBOOK_ADVISOR_DATA_PROCESSING_APPROVAL": "pending"
